# Copy to .env and adjust. Everything here is optional in development.

PORT=3210
HOST=0.0.0.0

# Where the SQLite database and generated keys live. Back this folder up.
DATA_DIR=./data

# Needed to create a profile or reset a PIN. If unset, one is generated on
# first start and saved to DATA_DIR/admin-key.txt.
ADMIN_KEY=

# Set to 1 when running behind a reverse proxy (Caddy, Cloudflare Tunnel) so
# rate limiting sees the real client IP.
TRUST_PROXY=0

# Session cookie is HTTPS-only in production. Set to 0 only for plain-HTTP testing.
COOKIE_SECURE=

# Web Push. If unset, a key pair is generated and saved to DATA_DIR/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
